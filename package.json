{
  "name": "glancelet",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "build": "npm run build --workspace @glancelet/desktop",
    "dev": "npm run dev --workspace @glancelet/desktop",
